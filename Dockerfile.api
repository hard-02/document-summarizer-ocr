# Lightweight image for the Gemini API backend (no PyTorch, no OCR).
# Used for the free Render / Streamlit-style deployment.
FROM python:3.11-slim

WORKDIR /app

COPY requirements-api.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-api.txt

COPY src/ ./src/
COPY web/ ./web/

ENV SUMMARY_PROVIDER=gemini
ENV FORCE_CPU=1
ENV PORT=7860

EXPOSE 7860

CMD ["sh", "-c", "uvicorn web.server:app --host 0.0.0.0 --port ${PORT:-7860}"]
